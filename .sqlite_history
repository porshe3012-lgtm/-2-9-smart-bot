-- 1. ตารางเก็บงานและการบ้าน
CREATE TABLE homework (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    subject TEXT,
    details TEXT,
    deadline DATE,
    status TEXT DEFAULT 'pending'
);
-- 2. ตารางเก็บเวรยกหนังสือ (สังคม/ประวัติ)
CREATE TABLE book_duty (
    id INTEGER PRIMARY KEY,
    last_student_1 INTEGER,
    last_student_2 INTEGER
);
-- 3. ตารางรายชื่อนักเรียน (เพื่อใช้ในการสุ่มและเช็คงาน)
CREATE TABLE students (
    student_no INTEGER PRIMARY KEY,
    name TEXT
);
